'use strict';
// Auto-instrument HTTP, Express/Fastify, PostgreSQL, Redis and messaging clients.
// The SDK exports OTLP spans to the local Jaeger all-in-one collector.
const { NodeSDK } = require('@opentelemetry/sdk-node');
const { OTLPTraceExporter } = require('@opentelemetry/exporter-trace-otlp-http');
const { getNodeAutoInstrumentations } = require('@opentelemetry/auto-instrumentations-node');
const { resourceFromAttributes } = require('@opentelemetry/resources');
const serviceName = process.env.OTEL_SERVICE_NAME || process.env.SERVICE_NAME || 'aerobooking-service';
const sdk = new NodeSDK({
  resource: resourceFromAttributes({ 'service.name': serviceName, 'service.namespace': 'aerobooking', 'deployment.environment': process.env.NODE_ENV || 'development' }),
  traceExporter: new OTLPTraceExporter({ url: process.env.OTEL_EXPORTER_OTLP_TRACES_ENDPOINT || 'http://jaeger:4318/v1/traces' }),
  instrumentations: [getNodeAutoInstrumentations({
    '@opentelemetry/instrumentation-fs': { enabled: false },
    '@opentelemetry/instrumentation-dns': { enabled: false },
  })],
});
sdk.start();
const shutdown = () => sdk.shutdown().catch(() => {});
process.once('SIGTERM', shutdown);
process.once('SIGINT', shutdown);
