{
  "uid": "aerobooking-logs",
  "title": "AeroBooking | Centralized Logs",
  "tags": [
    "aerobooking",
    "logs",
    "loki",
    "forensics"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "All service logs",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{container=~\".*(auth|search|booking|airline|audit|kong).*\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Error and warning logs",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{container=~\".*(auth|search|booking|airline|audit|kong).*\"} |~ \"(?i)(error|exception|fatal|warn)\"",
          "refId": "A"
        }
      ]
    }
  ],
  "editable": true,
  "graphTooltip": 1
}