        "y": 12
      },
      "targets": [
        {
          "expr": "aerobooking_outbox_unpublished",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": null,
          "max": null
        },
        "overrides": []
      },
      "options": {}
