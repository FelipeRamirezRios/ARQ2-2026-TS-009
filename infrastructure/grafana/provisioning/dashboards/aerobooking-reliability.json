{
  "id": null,
  "uid": "aerobooking-reliability",
  "title": "AeroBooking | Reliability & Reconciliation",
  "tags": [
    "aerobooking",
    "reliability",
    "saga"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "Airline circuit breaker",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "max(aerobooking_airline_circuit_open)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Circuit transitions / 5m",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (state) (increase(aerobooking_airline_circuit_transitions_total[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": null,
          "max": null
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Outbox publish failures / 5m",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "increase(aerobooking_outbox_publish_failures_total[5m])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": null,
          "max": null
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Reconciliation findings",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (code,severity) (increase(aerobooking_reconciliation_findings_total[1h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": null,
          "max": null
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Unpublished outbox backlog",
