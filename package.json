{
  "name": "aerobooking-wave2",
  "version": "1.0.0",
  "private": true,
  "description": "AeroBooking distributed GDS - Wave 2 implementation for Team 009",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/bootstrap.js",
    "keys:generate": "node scripts/bootstrap.js",
    "start:auth": "node services/auth/index.js",
    "start:search": "node services/search/index.js",
    "start:booking": "node services/booking/index.js",
    "start:airline": "node services/airline-connector/index.js",
    "start:audit": "node services/audit/index.js",
    "test": "node --test tests/*.test.js",
    "test:smoke": "node tests/smoke.js",
    "test:enterprise": "node --test tests/enterprise.test.js",
    "test:contracts": "node --test tests/enterprise.test.js",
    "backup": "powershell -ExecutionPolicy Bypass -File scripts/backup.ps1",
    "restore": "powershell -ExecutionPolicy Bypass -File scripts/restore.ps1",
    "load": "k6 run load/booking-read.js",
    "chaos:airline": "powershell -ExecutionPolicy Bypass -File scripts/chaos-airline.ps1"
  },
  "dependencies": {
    "amqplib": "^0.10.8",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "fastify": "^5.6.1",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "opossum": "^8.5.0",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "uuid": "^11.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.57.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.57.2"
  }
}
