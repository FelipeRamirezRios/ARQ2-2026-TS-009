        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Inicializar_Bot_A">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def rows = (10..30)
def columns = [&apos;A&apos;, &apos;B&apos;, &apos;C&apos;, &apos;D&apos;, &apos;E&apos;, &apos;F&apos;]
def random = new Random()
def seat

do {
    seat = &quot;${rows[random.nextInt(rows.size())]}${columns[random.nextInt(columns.size())]}&quot;
} while (seat == &apos;12A&apos;)

vars.put(&apos;SEAT_A&apos;, seat)
vars.put(&apos;ATTEMPTS_A&apos;, &apos;0&apos;)
vars.put(&apos;LOCK_A&apos;, &apos;&apos;)
vars.put(&apos;LOCK_A_ERROR&apos;, &apos;&apos;)
vars.put(&apos;RETRY_A&apos;, &apos;true&apos;)</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="Reintentar_Bloqueo_A" enabled="true">
          <stringProp name="WhileController.condition">${__groovy(vars.get(&apos;RETRY_A&apos;) == &apos;true&apos;)}</stringProp>
        </WhileController>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">vars.put(&apos;LOCK_A&apos;, &apos;&apos;)
vars.put(&apos;LOCK_A_ERROR&apos;, &apos;&apos;)
vars.put(&apos;RETRY_A&apos;, &apos;true&apos;)

if (vars.get(&apos;ATTEMPTS_A&apos;) == null) {
    vars.put(&apos;ATTEMPTS_A&apos;, &apos;0&apos;)
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
