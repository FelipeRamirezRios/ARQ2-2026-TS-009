                </elementProp>
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Accept</stringProp>
                  <stringProp name="Header.value">application/json</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <JMESPathExtractor guiclass="JMESPathExtractorGui" testclass="JMESPathExtractor" testname="Extraer_LockToken_A" enabled="true">
              <stringProp name="JMESExtractor.referenceName">LOCK_A</stringProp>
              <stringProp name="JMESExtractor.jmesPathExpr">lockToken</stringProp>
              <stringProp name="JMESExtractor.matchNumber">1</stringProp>
              <stringProp name="JMESExtractor.defaultValue">LOCK_A_NO_RECIBIDO</stringProp>
            </JMESPathExtractor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">def responseCode = prev.getResponseCode()

int attempts = (vars.get(&apos;ATTEMPTS_A&apos;) ?: &apos;0&apos;).toInteger()
attempts++
vars.put(&apos;ATTEMPTS_A&apos;, attempts.toString())

if (responseCode == &apos;200&apos;) {
    vars.put(&apos;LOCK_A_ERROR&apos;, &apos;&apos;)
    vars.put(&apos;RETRY_A&apos;, &apos;false&apos;)

} else if (responseCode == &apos;409&apos; &amp;&amp; attempts &lt; 10) {
    vars.put(&apos;LOCK_A_ERROR&apos;, &apos;RETRY&apos;)
    vars.put(&apos;RETRY_A&apos;, &apos;true&apos;)

    def rows = (10..30).findAll { it != 12 }
    def columns = [&apos;A&apos;, &apos;B&apos;, &apos;C&apos;, &apos;D&apos;, &apos;E&apos;, &apos;F&apos;]

    def random = new Random()
    def newSeat

    do {
        newSeat = &quot;${rows[random.nextInt(rows.size())]}${columns[random.nextInt(columns.size())]}&quot;
    } while (newSeat == vars.get(&apos;SEAT_A&apos;))

    vars.put(&apos;SEAT_A&apos;, newSeat)

} else {
    vars.put(&apos;LOCK_A_ERROR&apos;, responseCode)
    vars.put(&apos;RETRY_A&apos;, &apos;false&apos;)
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="If Controller" enabled="true">
          <stringProp name="IfController.condition">${__groovy(vars.get(&apos;LOCK_A&apos;) != null &amp;&amp; !vars.get(&apos;LOCK_A&apos;).isEmpty() &amp;&amp; vars.get(&apos;LOCK_A&apos;) != &apos;LOCK_A_NO_RECIBIDO&apos;)}</stringProp>
