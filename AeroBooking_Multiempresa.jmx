        <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="Reintentar_Bloqueo_B" enabled="true">
          <stringProp name="WhileController.condition">${__groovy(vars.get(&apos;RETRY_B&apos;) == &apos;true&apos;)}</stringProp>
        </WhileController>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Preparar_Intento_B" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">vars.put(&apos;LOCK_B&apos;, &apos;&apos;)
vars.put(&apos;LOCK_B_ERROR&apos;, &apos;&apos;)</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Bloquear_Asiento_B">
            <stringProp name="HTTPSampler.domain">localhost</stringProp>
